import pygame
import random
import sys


# =========================================================
# INITIALIZE
# =========================================================

pygame.init()


# =========================================================
# WINDOW
# =========================================================

WIDTH = 600
HEIGHT = 800

screen = pygame.display.set_mode((WIDTH, HEIGHT))

pygame.display.set_caption("Turbo Racer")


# =========================================================
# CLOCK
# =========================================================

clock = pygame.time.Clock()


# =========================================================
# COLORS
# =========================================================

ROAD = (55, 55, 60)
GRASS = (35, 120, 55)
WHITE = (255, 255, 255)
BLACK = (15, 15, 15)
RED = (220, 40, 40)
BLUE = (40, 100, 230)
YELLOW = (255, 200, 40)
GRAY = (180, 180, 180)


# =========================================================
# ROAD
# =========================================================

ROAD_LEFT = 100
ROAD_RIGHT = 500
ROAD_WIDTH = ROAD_RIGHT - ROAD_LEFT


# =========================================================
# CAR
# =========================================================

CAR_WIDTH = 55
CAR_HEIGHT = 100


player_x = WIDTH // 2 - CAR_WIDTH // 2
player_y = HEIGHT - 150

player_speed = 7


# =========================================================
# ENEMY CARS
# =========================================================

enemy_width = 55
enemy_height = 100

enemy_speed = 6

enemies = []


# =========================================================
# GAME VARIABLES
# =========================================================

score = 0
lives = 3

game_over = False

road_line_y = 0


# =========================================================
# FONTS
# =========================================================

font = pygame.font.SysFont(
    "Arial",
    28,
    bold=True
)

big_font = pygame.font.SysFont(
    "Arial",
    55,
    bold=True
)


# =========================================================
# DRAW PLAYER CAR
# =========================================================

def draw_player_car(x, y):

    # Body
    pygame.draw.rect(
        screen,
        BLUE,
        (x, y, CAR_WIDTH, CAR_HEIGHT),
        border_radius=12
    )

    # Windshield
    pygame.draw.rect(
        screen,
        (150, 210, 240),
        (x + 10, y + 12, 35, 25),
        border_radius=5
    )

    # Rear window
    pygame.draw.rect(
        screen,
        (100, 170, 210),
        (x + 10, y + 63, 35, 20),
        border_radius=5
    )

    # Wheels
    pygame.draw.rect(
        screen,
        BLACK,
        (x - 5, y + 15, 8, 25)
    )

    pygame.draw.rect(
        screen,
        BLACK,
        (x + CAR_WIDTH - 3, y + 15, 8, 25)
    )

    pygame.draw.rect(
        screen,
        BLACK,
        (x - 5, y + 65, 8, 25)
    )

    pygame.draw.rect(
        screen,
        BLACK,
        (x + CAR_WIDTH - 3, y + 65, 8, 25)
    )


# =========================================================
# DRAW ENEMY CAR
# =========================================================

def draw_enemy_car(x, y):

    pygame.draw.rect(
        screen,
        RED,
        (x, y, enemy_width, enemy_height),
        border_radius=12
    )

    # Windshield
    pygame.draw.rect(
        screen,
        (150, 210, 240),
        (x + 10, y + 12, 35, 25),
        border_radius=5
    )

    # Rear window
    pygame.draw.rect(
        screen,
        (100, 170, 210),
        (x + 10, y + 63, 35, 20),
        border_radius=5
    )

    # Wheels
    pygame.draw.rect(
        screen,
        BLACK,
        (x - 5, y + 15, 8, 25)
    )

    pygame.draw.rect(
        screen,
        BLACK,
        (x + enemy_width - 3, y + 15, 8, 25)
    )

    pygame.draw.rect(
        screen,
        BLACK,
        (x - 5, y + 65, 8, 25)
    )

    pygame.draw.rect(
        screen,
        BLACK,
        (x + enemy_width - 3, y + 65, 8, 25)
    )


# =========================================================
# CREATE ENEMY
# =========================================================

def create_enemy():

    lane_width = ROAD_WIDTH // 4

    lane = random.randint(0, 3)

    x = ROAD_LEFT + lane * lane_width + (
        lane_width - enemy_width
    ) // 2

    y = -enemy_height

    enemies.append(
        [x, y]
    )


# =========================================================
# RESET GAME
# =========================================================

def reset_game():

    global player_x
    global score
    global lives
    global enemy_speed
    global enemies
    global game_over

    player_x = WIDTH // 2 - CAR_WIDTH // 2

    score = 0

    lives = 3

    enemy_speed = 6

    enemies = []

    game_over = False


# =========================================================
# MAIN GAME LOOP
# =========================================================

while True:

    # -----------------------------------------------------
    # EVENTS
    # -----------------------------------------------------

    for event in pygame.event.get():

        if event.type == pygame.QUIT:

            pygame.quit()

            sys.exit()


        if event.type == pygame.KEYDOWN:

            if event.key == pygame.K_r and game_over:

                reset_game()


            if event.key == pygame.K_ESCAPE:

                pygame.quit()

                sys.exit()


    # =====================================================
    # GAME LOGIC
    # =====================================================

    if not game_over:

        keys = pygame.key.get_pressed()


        # -------------------------------------------------
        # PLAYER MOVEMENT
        # -------------------------------------------------

        if keys[pygame.K_LEFT] or keys[pygame.K_a]:

            player_x -= player_speed


        if keys[pygame.K_RIGHT] or keys[pygame.K_d]:

            player_x += player_speed


        # Keep car on road

        if player_x < ROAD_LEFT:

            player_x = ROAD_LEFT


        if player_x + CAR_WIDTH > ROAD_RIGHT:

            player_x = ROAD_RIGHT - CAR_WIDTH


        # -------------------------------------------------
        # ROAD ANIMATION
        # -------------------------------------------------

        road_line_y += enemy_speed

        if road_line_y >= 80:

            road_line_y = 0


        # -------------------------------------------------
        # CREATE ENEMIES
        # -------------------------------------------------

        if random.randint(1, 35) == 1:

            create_enemy()


        # -------------------------------------------------
        # MOVE ENEMIES
        # -------------------------------------------------

        for enemy in enemies:

            enemy[1] += enemy_speed


        # -------------------------------------------------
        # COLLISION
        # -------------------------------------------------

        player_rect = pygame.Rect(
            player_x,
            player_y,
            CAR_WIDTH,
            CAR_HEIGHT
        )


        for enemy in enemies[:]:

            enemy_rect = pygame.Rect(
                enemy[0],
                enemy[1],
                enemy_width,
                enemy_height
            )


            if player_rect.colliderect(enemy_rect):

                enemies.remove(enemy)

                lives -= 1


                if lives <= 0:

                    game_over = True


        # -------------------------------------------------
        # REMOVE OLD ENEMIES
        # -------------------------------------------------

        for enemy in enemies[:]:

            if enemy[1] > HEIGHT:

                enemies.remove(enemy)

                score += 1


        # -------------------------------------------------
        # INCREASE DIFFICULTY
        # -------------------------------------------------

        if score > 0 and score % 10 == 0:

            enemy_speed = min(
                15,
                6 + score // 10
            )


    # =====================================================
    # DRAW BACKGROUND
    # =====================================================

    screen.fill(GRASS)


    # =====================================================
    # DRAW ROAD
    # =====================================================

    pygame.draw.rect(
        screen,
        ROAD,
        (
            ROAD_LEFT,
            0,
            ROAD_WIDTH,
            HEIGHT
        )
    )


    # =====================================================
    # ROAD EDGES
    # =====================================================

    pygame.draw.rect(
        screen,
        WHITE,
        (
            ROAD_LEFT,
            0,
            5,
            HEIGHT
        )
    )

    pygame.draw.rect(
        screen,
        WHITE,
        (
            ROAD_RIGHT - 5,
            0,
            5,
            HEIGHT
        )
    )


    # =====================================================
    # ROAD LINES
    # =====================================================

    lane_width = ROAD_WIDTH // 4

    for lane in range(1, 4):

        x = ROAD_LEFT + lane * lane_width

        for y in range(
            -80,
            HEIGHT,
            80
        ):

            pygame.draw.rect(
                screen,
                WHITE,
                (
                    x - 3,
                    y + road_line_y,
                    6,
                    40
                )
            )


    # =====================================================
    # DRAW ENEMIES
    # =====================================================

    for enemy in enemies:

        draw_enemy_car(
            enemy[0],
            enemy[1]
        )


    # =====================================================
    # DRAW PLAYER
    # =====================================================

    if not game_over:

        draw_player_car(
            player_x,
            player_y
        )


    # =====================================================
    # SCORE
    # =====================================================

    score_text = font.render(
        f"Score: {score}",
        True,
        WHITE
    )

    screen.blit(
        score_text,
        (20, 20)
    )


    # =====================================================
    # LIVES
    # =====================================================

    lives_text = font.render(
        f"❤️ Lives: {lives}",
        True,
        WHITE
    )

    screen.blit(
        lives_text,
        (20, 55)
    )


    # =====================================================
    # SPEED
    # =====================================================

    speed_text = font.render(
        f"Speed: {enemy_speed}",
        True,
        WHITE
    )

    screen.blit(
        speed_text,
        (WIDTH - 150, 20)
    )


    # =====================================================
    # GAME OVER
    # =====================================================

    if game_over:

        overlay = pygame.Surface(
            (WIDTH, HEIGHT)
        )

        overlay.set_alpha(180)

        overlay.fill(BLACK)

        screen.blit(
            overlay,
            (0, 0)
        )


        game_over_text = big_font.render(
            "GAME OVER",
            True,
            RED
        )

        screen.blit(
            game_over_text,
            (
                WIDTH // 2 -
                game_over_text.get_width() // 2,
                280
            )
        )


        final_score = font.render(
            f"Final Score: {score}",
            True,
            WHITE
        )

        screen.blit(
            final_score,
            (
                WIDTH // 2 -
                final_score.get_width() // 2,
                350
            )
        )


        restart_text = font.render(
            "Press R to Restart",
            True,
            YELLOW
        )

        screen.blit(
            restart_text,
            (
                WIDTH // 2 -
                restart_text.get_width() // 2,
                410
            )
        )


    # =====================================================
    # UPDATE SCREEN
    # =====================================================

    pygame.display.flip()

    clock.tick(60)
