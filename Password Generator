# =========================================================
# GENERATE PASSWORD
# =========================================================

def generate_password():

    # Ask for reference name

    reference = simpledialog.askstring(
        "Reference Name",
        "Enter your reference name:",
        parent=window
    )

    # Cancel pressed

    if reference is None:
        return

    reference = reference.strip()

    # Check reference

    if reference == "":

        messagebox.showwarning(
            "Missing Reference",
            "Please enter a reference name."
        )

        return

    # -----------------------------------------------------
    # CHARACTER SET
    # -----------------------------------------------------

    characters = string.ascii_lowercase

    if uppercase.get():
        characters += string.ascii_uppercase

    if numbers.get():
        characters += string.digits

    if symbols.get():
        characters += "!@#$%^&*_-+=?"

    # -----------------------------------------------------
    # LENGTH
    # -----------------------------------------------------

    password_length = length.get()

    if len(reference) >= password_length:

        messagebox.showwarning(
            "Password Too Short",
            "The password length must be longer than the reference name."
        )

        return

    # -----------------------------------------------------
    # GENERATE RANDOM PART
    # -----------------------------------------------------

    random_length = password_length - len(reference)

    random_part = ""

    for _ in range(random_length):

        random_part += secrets.choice(
            characters
        )

    # -----------------------------------------------------
    # COMBINE
    # -----------------------------------------------------

    password = reference + random_part

    # -----------------------------------------------------
    # SHUFFLE
    # -----------------------------------------------------

    password_list = list(password)

    for i in range(
        len(password_list) - 1,
        0,
        -1
    ):

        j = secrets.randbelow(i + 1)

        password_list[i], password_list[j] = (
            password_list[j],
            password_list[i]
        )

    password = "".join(password_list)

    # -----------------------------------------------------
    # IMPORTANT:
    # MAKE SURE REFERENCE IS PRESENT
    # -----------------------------------------------------

    # If the shuffle separated the reference,
    # this guarantees the exact reference appears.

    if reference not in password:

        password = (
            reference +
            password[:password_length - len(reference)]
        )

    # -----------------------------------------------------
    # DISPLAY
    # -----------------------------------------------------

    password_box.delete(
        0,
        tk.END
    )

    password_box.insert(
        0,
        password
    )

    check_strength(password)


# =========================================================
# PASSWORD STRENGTH
# =========================================================

def check_strength(password):

    score = 0

    if len(password) >= 12:
        score += 1

    if len(password) >= 16:
        score += 1

    if any(c.isupper() for c in password):
        score += 1

    if any(c.islower() for c in password):
        score += 1

    if any(c.isdigit() for c in password):
        score += 1

    if any(
        c in "!@#$%^&*_-+=?"
        for c in password
    ):
        score += 1

    if score <= 2:

        strength_label.config(
            text="Password strength: WEAK",
            fg=RED
        )

    elif score <= 4:

        strength_label.config(
            text="Password strength: MEDIUM",
            fg="#FFB020"
        )

    else:

        strength_label.config(
            text="Password strength: STRONG",
            fg=GREEN
        )


# =========================================================
# COPY
# =========================================================

def copy_password():

    password = password_box.get()

    if password == "":

        messagebox.showwarning(
            "Nothing to Copy",
            "Generate a password first."
        )

        return

    window.clipboard_clear()

    window.clipboard_append(
        password
    )

    window.update()

    messagebox.showinfo(
        "Copied",
        "Password copied to clipboard!"
    )


