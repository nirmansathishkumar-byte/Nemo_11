# =========================================================
# CALCULATE
# =========================================================

def calculate():

    try:

        # ---------------------------------------------
        # CAR 1
        # ---------------------------------------------

        name1 = car1["Car Name"].get()

        hp1 = float(
            car1["Horsepower (HP)"].get()
        )

        weight1 = float(
            car1["Weight (kg)"].get()
        )

        speed1 = float(
            car1["Top Speed (km/h)"].get()
        )


        # ---------------------------------------------
        # CAR 2
        # ---------------------------------------------

        name2 = car2["Car Name"].get()

        hp2 = float(
            car2["Horsepower (HP)"].get()
        )

        weight2 = float(
            car2["Weight (kg)"].get()
        )

        speed2 = float(
            car2["Top Speed (km/h)"].get()
        )


        if (
            hp1 <= 0
            or weight1 <= 0
            or speed1 <= 0
            or hp2 <= 0
            or weight2 <= 0
            or speed2 <= 0
        ):
            raise ValueError


        # =================================================
        # CALCULATIONS
        # =================================================

        # Power in kW

        kw1 = hp1 * 0.7457
        kw2 = hp2 * 0.7457


        # HP per ton

        pwt1 = hp1 / (weight1 / 1000)
        pwt2 = hp2 / (weight2 / 1000)


        # Estimated 0-100

        zero100_1 = 0.65 * math.sqrt(
            weight1 / hp1
        )

        zero100_2 = 0.65 * math.sqrt(
            weight2 / hp2
        )


        # =================================================
        # DISPLAY
        # =================================================

        result_labels["Power"][0].config(
            text=f"{kw1:.1f} kW"
        )

        result_labels["Power"][1].config(
            text=f"{kw2:.1f} kW"
        )


        result_labels["Power / Weight"][0].config(
            text=f"{pwt1:.1f} HP / ton"
        )

        result_labels["Power / Weight"][1].config(
            text=f"{pwt2:.1f} HP / ton"
        )


        result_labels["Estimated 0–100"][0].config(
            text=f"{zero100_1:.2f} sec"
        )

        result_labels["Estimated 0–100"][1].config(
            text=f"{zero100_2:.2f} sec"
        )


        result_labels["Top Speed"][0].config(
            text=f"{speed1:.0f} km/h"
        )

        result_labels["Top Speed"][1].config(
            text=f"{speed2:.0f} km/h"
        )


        # =================================================
        # WINNER
        # =================================================

        if pwt1 > pwt2:

            winner_label.config(
                text=f"🏆 {name1} WINS ON POWER-TO-WEIGHT",
                fg=BLUE
            )

        elif pwt2 > pwt1:

            winner_label.config(
                text=f"🏆 {name2} WINS ON POWER-TO-WEIGHT",
                fg=ACCENT
            )

        else:

            winner_label.config(
                text="🤝 BOTH CARS HAVE THE SAME POWER-TO-WEIGHT",
                fg=GREEN
            )


    except ValueError:

        messagebox.showerror(
            "Invalid Input",
            "Please enter valid positive numbers."
        )


