# =========================================================
# CREATE CAR INPUT CARD
# =========================================================

def create_car_card(parent, title_text):

    card = tk.Frame(
        parent,
        bg=CARD,
        width=390,
        height=250
    )

    card.pack_propagate(False)

    title = tk.Label(
        card,
        text=title_text,
        font=("Arial", 19, "bold"),
        bg=CARD,
        fg=TEXT
    )

    title.pack(pady=(15, 10))

    entries = {}

    fields = [
        ("Car Name", "BMW M5"),
        ("Horsepower (HP)", "617"),
        ("Weight (kg)", "1970"),
        ("Top Speed (km/h)", "305")
    ]

    for label_text, default in fields:

        row = tk.Frame(
            card,
            bg=CARD
        )

        row.pack(
            fill="x",
            padx=15,
            pady=4
        )

        label = tk.Label(
            row,
            text=label_text,
            font=("Arial", 10),
            bg=CARD,
            fg=SECONDARY,
            width=17,
            anchor="w"
        )

        label.pack(side="left")

        entry = tk.Entry(
            row,
            font=("Arial", 11),
            bg=INPUT_BG,
            fg=TEXT,
            insertbackground=TEXT,
            bd=0,
            justify="center",
            width=16
        )

        entry.pack(side="right")

        entry.insert(0, default)

        entries[label_text] = entry

    return entries


