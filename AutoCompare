result_labels = {}


def create_result_row(name, row):

    metric = tk.Label(
        results_frame,
        text=name,
        font=("Arial", 11, "bold"),
        bg=CARD,
        fg=SECONDARY,
        width=22
    )

    metric.grid(
        row=row,
        column=0,
        pady=7
    )

    car1_result = tk.Label(
        results_frame,
        text="--",
        font=("Arial", 12, "bold"),
        bg=CARD,
        fg=BLUE,
        width=22
    )

    car1_result.grid(
        row=row,
        column=1
    )

    car2_result = tk.Label(
        results_frame,
        text="--",
        font=("Arial", 12, "bold"),
        bg=CARD,
        fg=ACCENT,
        width=22
    )

    car2_result.grid(
        row=row,
        column=2
    )

    result_labels[name] = (
        car1_result,
        car2_result
    )


