# =========================================================
# UPDATE SCORE
# =========================================================

def update_score():

    score_label.config(
        text=f"Score: {score} / {attempts}"
    )

    if attempts > 0:

        accuracy = (
            score / attempts
        ) * 100

        accuracy_label.config(
            text=f"Accuracy: {accuracy:.0f}%"
        )

    else:

        accuracy_label.config(
            text="Accuracy: 0%"
        )


# =========================================================
# NEW NOTE
# =========================================================

def new_note():

    global current_note

    current_note = random.choice(
        NOTES
    )

    target_label.config(
        text=current_note
    )

    result_label.config(
        text="Listen and play the note!",
        fg=SECONDARY
    )

    # Play the target note
    play_note(
        current_note
    )


# =========================================================
# CHECK KEY
# =========================================================

def check_key(event):

    global score
    global attempts

    key = event.keysym.lower()

    # Ignore other keyboard keys
    if key not in KEY_MAP:
        return

    played_note = KEY_MAP[key]

    attempts += 1

    # -----------------------------------------------------
    # CORRECT ANSWER
    # -----------------------------------------------------

    if played_note == current_note:

        score += 1

        result_label.config(
            text="✅ CORRECT!",
            fg=GREEN
        )

        play_note(
            played_note
        )

        update_score()

        # Show a new note after 0.7 seconds
        window.after(
            700,
            new_note
        )

    # -----------------------------------------------------
    # WRONG ANSWER
    # -----------------------------------------------------

    else:

        result_label.config(
            text=f"❌ You played {played_note}",
            fg=RED
        )

        play_note(
            played_note
        )

        update_score()


