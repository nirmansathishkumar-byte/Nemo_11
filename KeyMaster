    "f": "F",
    "g": "G",
    "h": "A",
    "j": "B"
}


# =========================================================
# CREATE NOTE SOUND
# =========================================================

def create_note_sound(frequency):

    sample_rate = 44100

    duration = 0.5

    number_of_samples = int(
        sample_rate * duration
    )

    audio = bytearray()

    for i in range(number_of_samples):

        time = i / sample_rate

        # Main note
        main_tone = math.sin(
            2 * math.pi * frequency * time
        )

        # Harmonic for a slightly nicer sound
        harmonic = 0.25 * math.sin(
            2 * math.pi * frequency * 2 * time
        )

        value = (
            main_tone + harmonic
        ) * 0.35

        # Fade the sound out
        fade = 1 - (
            i / number_of_samples
        )

        value *= fade

        sample = int(
            value * 32767
        )

        audio.extend(
            struct.pack(
                "<h",
                sample
            )
        )

    temp_file = tempfile.NamedTemporaryFile(
        suffix=".wav",
        delete=False
    )

    filename = temp_file.name

    temp_file.close()

    with wave.open(
        filename,
        "wb"
    ) as sound:

        sound.setnchannels(1)

        sound.setsampwidth(2)

        sound.setframerate(
            sample_rate
        )

        sound.writeframes(
            audio
        )

    return filename


# =========================================================
# CREATE ALL NOTE SOUNDS
# =========================================================

NOTE_SOUNDS = {}

for note in NOTES:

    NOTE_SOUNDS[note] = create_note_sound(
        FREQUENCIES[note]
    )


# =========================================================
# PLAY NOTE
# =========================================================

def play_note(note):

    filename = NOTE_SOUNDS[note]

    try:

        subprocess.Popen(
            [
                "afplay",
                filename
            ],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL
        )

    except Exception as error:

        print(
            "Audio error:",
            error
        )


