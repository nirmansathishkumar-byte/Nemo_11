)


# ============================================================
# MEDIAPIPE MODEL
# ============================================================

MODEL_FILE = "hand_landmarker.task"

if not os.path.exists(MODEL_FILE):

    print()
    print("ERROR:")
    print("hand_landmarker.task was not found.")
    print()
    print("Put hand_landmarker.task in the same")
    print("folder as this Python file.")
    print()

    camera.release()

    raise SystemExit


# ============================================================
# MEDIAPIPE
# ============================================================

BaseOptions = mp.tasks.BaseOptions

HandLandmarkerOptions = (
    mp.tasks.vision.HandLandmarkerOptions
)

RunningMode = mp.tasks.vision.RunningMode


options = HandLandmarkerOptions(

    base_options=BaseOptions(
        model_asset_path=MODEL_FILE
    ),

    running_mode=RunningMode.VIDEO,

    num_hands=1,

    min_hand_detection_confidence=0.5,

    min_hand_presence_confidence=0.5,

    min_tracking_confidence=0.5
)


landmarker = (
    mp.tasks.vision.HandLandmarker
    .create_from_options(options)
)


# ============================================================
# PLAYER / CROSSHAIR
# ============================================================

aim_x = WIDTH // 2
aim_y = HEIGHT // 2

last_aim_x = aim_x
last_aim_y = aim_y


# ============================================================
# GAME VARIABLES
# ============================================================

targets = []

score = 0

misses = 0

MAX_MISSES = 10

game_over = False

target_timer = 0

target_delay = 55

game_time = 0

last_shot_time = 0

SHOT_COOLDOWN = 0.35

laser_start = None
laser_end = None
laser_timer = 0


# ============================================================
# STARS / BACKGROUND
# ============================================================

stars = []

for _ in range(120):

    stars.append({
        "x": random.randint(
            GAME_LEFT,
            GAME_RIGHT
        ),

        "y": random.randint(
            GAME_TOP,
            GAME_BOTTOM
        ),

        "speed": random.randint(
            1,
            3
        ),

        "size": random.randint(
            1,
            3
        )
    })


# ============================================================
# CREATE ROBOT TARGET
# ============================================================

def create_target():

    size = random.randint(
        40,
        65
    )

    x = random.randint(
        GAME_LEFT + size,
        GAME_RIGHT - size
    )

    y = random.randint(
        GAME_TOP + size,
        GAME_BOTTOM - size
    )

    # Horizontal movement
    vx = random.choice([
        -2,
        -1,
        1,
        2
    ])

    # Vertical movement
    vy = random.choice([
        -1,
        1
    ])

    targets.append({
        "x": float(x),
        "y": float(y),
        "size": size,
        "vx": vx,
        "vy": vy
    })


# ============================================================
# DRAW ROBOT
# ============================================================

def draw_robot(
    frame,
    target
):

    x = int(target["x"])
    y = int(target["y"])
    s = target["size"]

    # --------------------------------------------------------
    # Glow
    # --------------------------------------------------------

    cv2.circle(
        frame,
        (x, y),
        s + 8,
        DARK_RED,
        2
    )

    # --------------------------------------------------------
    # Head
    # --------------------------------------------------------

    head_w = int(s * 1.15)
    head_h = int(s * 0.85)

    x1 = x - head_w // 2
    y1 = y - head_h // 2

    x2 = x + head_w // 2
    y2 = y + head_h // 2

    cv2.rectangle(
        frame,
        (x1, y1),
        (x2, y2),
        RED,
        -1
    )

    cv2.rectangle(
        frame,
        (x1, y1),
        (x2, y2),
        WHITE,
        2
    )

    # --------------------------------------------------------
    # Eyes
    # --------------------------------------------------------

    eye_y = y - s // 8

    cv2.circle(
        frame,
        (
            x - s // 4,
            eye_y
        ),
        max(4, s // 10),
        CYAN,
        -1
    )

    cv2.circle(
        frame,
        (
            x + s // 4,
            eye_y
        ),
        max(4, s // 10),
        CYAN,
        -1
    )

    # --------------------------------------------------------
    # Mouth
    # --------------------------------------------------------

    cv2.line(
        frame,
        (
            x - s // 4,
            y + s // 5
        ),
        (
            x + s // 4,
            y + s // 5
        ),
        BLACK,
        3
    )

    # --------------------------------------------------------
    # Antenna
    # --------------------------------------------------------

    cv2.line(
        frame,
        (
            x,
            y1
        ),
        (
            x,
            y1 - s // 3
        ),
        WHITE,
        3
    )

    cv2.circle(
        frame,
        (
            x,
            y1 - s // 3
        ),
        max(4, s // 10),
        GREEN,
        -1
    )

    # --------------------------------------------------------
    # Body
    # --------------------------------------------------------

    body_top = y2

    body_bottom = y + s

    cv2.rectangle(
        frame,
        (
            x - s // 2,
            body_top
        ),
        (
            x + s // 2,
            body_bottom
        ),
        DARK_RED,
        -1
    )

    # --------------------------------------------------------
    # Arms
    # --------------------------------------------------------

    cv2.line(
        frame,
        (
            x - s // 2,
            y + s // 2
        ),
        (
            x - int(s * 0.85),
            y + int(s * 0.75)
        ),
        WHITE,
        5
    )

    cv2.line(
        frame,
        (
            x + s // 2,
            y + s // 2
        ),
        (
            x + int(s * 0.85),
            y + int(s * 0.75)
        ),
        WHITE,
        5
    )

    # --------------------------------------------------------
    # Legs
    # --------------------------------------------------------

    cv2.line(
        frame,
        (
            x - s // 4,
            body_bottom
        ),
        (
            x - s // 4,
            body_bottom + s // 3
        ),
        WHITE,
        5
    )

    cv2.line(
        frame,
        (
            x + s // 4,
            body_bottom
        ),
        (
            x + s // 4,
            body_bottom + s // 3
        ),
        WHITE,
        5
    )


# ============================================================
# DISTANCE
# ============================================================

def distance(
    x1,
    y1,
    x2,
    y2
):

    return math.sqrt(
        (x1 - x2) ** 2
        +
        (y1 - y2) ** 2
    )


# ============================================================
# SHOOT
# ============================================================

def shoot():

    global score
    global misses
    global laser_start
    global laser_end
    global laser_timer
    global last_shot_time

    current_time = time.time()

    # Prevent continuous shooting
    if (
        current_time
        -
        last_shot_time
        <
        SHOT_COOLDOWN
    ):

        return

    last_shot_time = current_time

    # Laser starts at crosshair
    laser_start = (
        aim_x,
        aim_y
    )

    laser_end = (
        aim_x,
        aim_y
    )

    laser_timer = 8

    # --------------------------------------------------------
    # Find nearest target to crosshair
    # --------------------------------------------------------

    hit_target = None

    closest_distance = 999999

    for target in targets:

        d = distance(
            aim_x,
            aim_y,
            target["x"],
            target["y"]
        )

        hit_radius = (
            target["size"]
            +
            10
        )

        if (
            d < hit_radius
            and
            d < closest_distance
        ):

            closest_distance = d

            hit_target = target

    # --------------------------------------------------------
    # HIT
    # --------------------------------------------------------

    if hit_target is not None:

        targets.remove(
            hit_target
        )

        score += 10

        # Make new target
        create_target()

    # --------------------------------------------------------
    # MISS
    # --------------------------------------------------------

    else:

        misses += 1

        if misses >= MAX_MISSES:

            global game_over

            game_over = True


# ============================================================
# RESET
# ============================================================

def reset_game():

    global targets
    global score
    global misses
    global game_over
    global target_timer
    global target_delay
    global game_time
    global laser_timer

    targets = []

    score = 0

    misses = 0

    game_over = False

    target_timer = 0

    target_delay = 55

    game_time = 0

    laser_timer = 0

    # Start with 3 targets
    for _ in range(3):

        create_target()


# ============================================================
# INITIAL TARGETS
# ============================================================

reset_game()


# ============================================================
# START MESSAGE
# ============================================================

print()
print("==============================================")
print("       GESTURE ROBOT TARGET GAME")
print("==============================================")
print()
print("MOVE YOUR HAND:")
print()
print("LEFT  -> AIM LEFT")
print("RIGHT -> AIM RIGHT")
print("UP    -> AIM UP")
print("DOWN  -> AIM DOWN")
print()
print("PINCH THUMB + INDEX -> FIRE")
print()
print("RED ROBOTS = TARGETS")
print()
print("R -> RESTART")
print("Q -> QUIT")
print()
print("Starting...")
print()


start_time = time.time()

previous_pinch = False


# ============================================================
# MAIN LOOP
# ============================================================

while True:

    # ========================================================
    # CAMERA
    # ========================================================

    success, camera_frame = camera.read()

    if not success:

        print("Could not read camera.")

        break


    # Mirror camera
    camera_frame = cv2.flip(
        camera_frame,
        1
    )


    # ========================================================
    # MEDIAPIPE
    # ========================================================

    rgb = cv2.cvtColor(
        camera_frame,
        cv2.COLOR_BGR2RGB
    )


    mp_image = mp.Image(
        image_format=mp.ImageFormat.SRGB,
        data=rgb
    )


    timestamp = int(
        (
            time.time()
            -
            start_time
        )
        *
        1000
    )


    result = landmarker.detect_for_video(
        mp_image,
        timestamp
    )


    hand_detected = False

    pinch_detected = False


    # ========================================================
    # HAND FOUND
    # ========================================================

    if result.hand_landmarks:

        hand_detected = True

        hand = result.hand_landmarks[0]


        # ----------------------------------------------------
        # INDEX FINGER TIP
        # Landmark 8
        # ----------------------------------------------------

        index_tip = hand[8]


        # ----------------------------------------------------
        # THUMB TIP
        # Landmark 4
        # ----------------------------------------------------

        thumb_tip = hand[4]


        # ----------------------------------------------------
        # PALM
        # Landmark 9
        # ----------------------------------------------------

        palm = hand[9]


        # ----------------------------------------------------
        # CAMERA POSITION
        # ----------------------------------------------------

        cam_h, cam_w, _ = (
            camera_frame.shape
        )


        palm_px = int(
            palm.x * cam_w
        )

        palm_py = int(
            palm.y * cam_h
        )


        index_px = int(
            index_tip.x * cam_w
        )

        index_py = int(
            index_tip.y * cam_h
        )


        thumb_px = int(
            thumb_tip.x * cam_w
        )

        thumb_py = int(
            thumb_tip.y * cam_h
        )


        # ----------------------------------------------------
        # DRAW LANDMARKS
        # ----------------------------------------------------

        cv2.circle(
            camera_frame,
            (
                palm_px,
                palm_py
            ),
            12,
            GREEN,
            -1
        )


        cv2.circle(
            camera_frame,
            (
                index_px,
                index_py
            ),
            10,
            YELLOW,
            -1
        )


        cv2.circle(
            camera_frame,
            (
                thumb_px,
                thumb_py
            ),
            10,
            CYAN,
            -1
        )


        # Line between thumb/index
        cv2.line(
            camera_frame,
            (
                thumb_px,
                thumb_py
            ),
            (
                index_px,
                index_py
            ),
            WHITE,
            2
        )


        # ----------------------------------------------------
        # AIM USING PALM
        # ----------------------------------------------------

        target_x = int(
            GAME_LEFT
            +
            palm.x
            *
            (
                GAME_RIGHT
                -
                GAME_LEFT
            )
        )


        target_y = int(
            GAME_TOP
            +
            palm.y
            *
            (
                GAME_BOTTOM
                -
                GAME_TOP
            )
        )


        # Smooth aim
        aim_x = int(
            aim_x
            +
            (
                target_x
                -
                aim_x
            )
            * 0.25
        )


        aim_y = int(
            aim_y
            +
            (
                target_y
                -
                aim_y
            )
            * 0.25
        )


        # ----------------------------------------------------
        # PINCH DETECTION
        # ----------------------------------------------------

        pinch_distance = distance(
            index_tip.x,
            index_tip.y,
            thumb_tip.x,
            thumb_tip.y
        )


        # Small distance = fingers touching
        pinch_detected = (
            pinch_distance < 0.055
        )


        if pinch_detected:

            cv2.putText(
                camera_frame,
                "PINCH - FIRE!",
                (20, 80),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.75,
                YELLOW,
                2
            )

        else:

            cv2.putText(
                camera_frame,
                "MOVE HAND + PINCH TO FIRE",
                (20, 80),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.65,
                WHITE,
                2
            )


        cv2.putText(
            camera_frame,
            "HAND DETECTED",
            (20, 120),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.65,
            GREEN,
            2
        )


    else:

        cv2.putText(
            camera_frame,
            "SHOW YOUR HAND",
            (20, 45),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.8,
            RED,
            2
        )


    # ========================================================
    # FIRE ONLY WHEN PINCH STARTS
    # ========================================================

    if (
        pinch_detected
        and
        not previous_pinch
        and
        not game_over
    ):

        shoot()


    previous_pinch = pinch_detected


    # ========================================================
    # KEYBOARD BACKUP
    # ========================================================

    key = cv2.waitKey(1) & 0xFF


    if not game_over:

        if key == ord("a"):

            aim_x -= 20


        if key == ord("d"):

            aim_x += 20


        if key == ord("w"):

            aim_y -= 20


        if key == ord("s"):

            aim_y += 20


        # Space = fire
        if key == ord(" "):

            shoot()


    # Keep crosshair inside screen

    aim_x = max(
        GAME_LEFT,
        min(
            aim_x,
            GAME_RIGHT
        )
    )


    aim_y = max(
        GAME_TOP,
        min(
            aim_y,
            GAME_BOTTOM
        )
    )


    # ========================================================
    # GAME BACKGROUND
    # ========================================================

    game = np.zeros(
        (
            HEIGHT,
            WIDTH,
            3
        ),
        dtype=np.uint8
    )


    game[:] = BLACK


    # ========================================================
    # MOVING STARS
    # ========================================================

    if not game_over:

        for star in stars:

            star["y"] += star["speed"]

            if star["y"] > GAME_BOTTOM:

                star["y"] = GAME_TOP

                star["x"] = random.randint(
                    GAME_LEFT,
                    GAME_RIGHT
                )


    for star in stars:

        cv2.circle(
            game,
            (
                int(star["x"]),
                int(star["y"])
            ),
            star["size"],
            WHITE,
            -1
        )


    # ========================================================
    # BORDER
    # ========================================================

    cv2.rectangle(
        game,
        (
            GAME_LEFT,
            GAME_TOP
        ),
        (
            GAME_RIGHT,
            GAME_BOTTOM
        ),
        PURPLE,
        3
    )


    # ========================================================
    # SPAWN TARGETS
    # ========================================================

    if not game_over:

        target_timer += 1

        if target_timer >= target_delay:

            create_target()

            target_timer = 0


    # ========================================================
    # MOVE TARGETS
    # ========================================================

    if not game_over:

        for target in targets:

            target["x"] += target["vx"]

            target["y"] += target["vy"]


            size = target["size"]


            # Bounce horizontally

            if (
                target["x"]
                <
                GAME_LEFT + size
            ):

                target["x"] = (
                    GAME_LEFT + size
                )

                target["vx"] *= -1


            if (
                target["x"]
                >
                GAME_RIGHT - size
            ):

                target["x"] = (
                    GAME_RIGHT - size
                )

                target["vx"] *= -1


            # Bounce vertically

            if (
                target["y"]
                <
                GAME_TOP + size
            ):

                target["y"] = (
                    GAME_TOP + size
                )

                target["vy"] *= -1


            if (
                target["y"]
                >
                GAME_BOTTOM - size
            ):

                target["y"] = (
                    GAME_BOTTOM - size
                )

                target["vy"] *= -1


    # ========================================================
    # DRAW TARGETS
    # ========================================================

    for target in targets:

        draw_robot(
            game,
            target
        )


    # ========================================================
    # CROSSHAIR
    # ========================================================

    crosshair_size = 22

    cv2.circle(
        game,
        (
            int(aim_x),
            int(aim_y)
        ),
        crosshair_size,
        GREEN,
        2
    )


    cv2.line(
        game,
        (
            int(aim_x - 35),
            int(aim_y)
        ),
        (
            int(aim_x - 10),
            int(aim_y)
        ),
        GREEN,
        2
    )


    cv2.line(
        game,
        (
            int(aim_x + 10),
            int(aim_y)
        ),
        (
            int(aim_x + 35),
            int(aim_y)
        ),
        GREEN,
        2
    )


    cv2.line(
        game,
        (
            int(aim_x),
            int(aim_y - 35)
        ),
        (
            int(aim_x),
            int(aim_y - 10)
        ),
        GREEN,
        2
    )


    cv2.line(
        game,
        (
            int(aim_x),
            int(aim_y + 10)
        ),
        (
            int(aim_x),
            int(aim_y + 35)
        ),
        GREEN,
        2
    )


    # ========================================================
    # LASER EFFECT
    # ========================================================

    if laser_timer > 0:

        cv2.line(
            game,
            laser_start,
            laser_end,
            YELLOW,
            5
        )

        cv2.circle(
            game,
            laser_end,
            10,
            YELLOW,
            2
        )

        laser_timer -= 1


    # ========================================================
    # HUD
    # ========================================================

    cv2.putText(
        game,
        f"SCORE: {score}",
        (55, 70),
        cv2.FONT_HERSHEY_SIMPLEX,
        1.0,
        WHITE,
        3
    )


    cv2.putText(
        game,
        f"MISSES: {misses}/{MAX_MISSES}",
        (55, 110),
        cv2.FONT_HERSHEY_SIMPLEX,
        0.65,
        RED,
        2
    )


    cv2.putText(
        game,
        "PINCH THUMB + INDEX TO FIRE",
        (285, 70),
        cv2.FONT_HERSHEY_SIMPLEX,
        0.6,
        YELLOW,
        2
    )


    # ========================================================
    # GAME OVER
    # ========================================================

    if game_over:

        cv2.rectangle(
            game,
            (
                130,
                190
            ),
            (
                770,
                510
            ),
            BLACK,
            -1
        )


        cv2.rectangle(
            game,
            (
                130,
                190
            ),
            (
                770,
                510
            ),
            PURPLE,
            4
        )


        cv2.putText(
            game,
            "GAME OVER",
            (
                285,
                290
            ),
            cv2.FONT_HERSHEY_SIMPLEX,
            1.7,
            RED,
            5
        )


        cv2.putText(
            game,
            f"FINAL SCORE: {score}",
            (
                285,
                350
            ),
            cv2.FONT_HERSHEY_SIMPLEX,
            1.0,
            WHITE,
            3
        )


        cv2.putText(
            game,
            "PRESS R TO RESTART",
            (
                270,
                420
            ),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.8,
            YELLOW,
            2
        )


        cv2.putText(
            game,
            "PRESS Q TO QUIT",
            (
                315,
                465
            ),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.8,
            WHITE,
            2
        )


    # ========================================================
    # DISPLAY
    # ========================================================

    cv2.imshow(
        "GESTURE ROBOT TARGET GAME",
        game
    )


    cv2.imshow(
        "HAND CAMERA",
        camera_frame
    )


    # ========================================================
    # QUIT
    # ========================================================

    if key == ord("q"):

        break


    # ========================================================
    # RESTART
    # ========================================================

    if (
        key == ord("r")
        and game_over
    ):

        reset_game()


# ============================================================
# CLEANUP
# ============================================================

landmarker.close()

camera.release()

cv2.destroyAllWindows()

print()
print("Game closed.")
