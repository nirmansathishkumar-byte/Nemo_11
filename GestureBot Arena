import cv2
import numpy as np
import mediapipe as mp
import random
import time
import os
import math


# ============================================================
# GESTURE ROBOT TARGET GAME
# ============================================================

WIDTH = 900
HEIGHT = 700

GAME_LEFT = 30
GAME_RIGHT = WIDTH - 30
GAME_TOP = 30
GAME_BOTTOM = HEIGHT - 30

# ============================================================
# COLORS - BGR
# ============================================================

BLACK = (0, 0, 0)
WHITE = (255, 255, 255)

BLUE = (255, 120, 30)
LIGHT_BLUE = (255, 220, 150)

RED = (40, 40, 240)
DARK_RED = (20, 20, 140)

GREEN = (50, 220, 70)

YELLOW = (0, 240, 255)

PURPLE = (200, 60, 200)

CYAN = (255, 220, 50)

GRAY = (80, 80, 80)


# ============================================================
# CAMERA
# ============================================================

camera = cv2.VideoCapture(0)

if not camera.isOpened():

    print()
    print("ERROR: Camera could not be opened.")
    print()
    print("On macOS:")
    print("System Settings -> Privacy & Security -> Camera")
    print("Allow camera access for VS Code.")
    print()

    raise SystemExit


camera.set(
    cv2.CAP_PROP_FRAME_WIDTH,
