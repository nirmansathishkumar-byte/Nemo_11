from ollama import chat

print("Nirmans AI Chatbot 🤖")
print("Type 'bye' to exit.\n")

while True:
    message = input("mine:")

    if message.lower() == "bye":
        print("Goodbye! 👋")
        break

    response = chat(
        model="llama3.2",
        messages=[
            {"role": "user", "content": message}
        ]
    )

    print("AI:", response.message.content)

    '''     YOUR PYTHON PROGRAM
