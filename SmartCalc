# =========================================================
# CALCULATOR STATE
# =========================================================

expression = ""


# =========================================================
# FUNCTIONS
# =========================================================

def update_display():
    display.delete(0, tk.END)

    if expression:
        display.insert(0, expression)
    else:
        display.insert(0, "0")


def add_value(value):
    global expression

    expression += value
    update_display()


def clear():
    global expression

    expression = ""
    update_display()


def backspace():
    global expression

    expression = expression[:-1]
    update_display()


def calculate():
    global expression

    if not expression:
        return

    try:
        calculation = expression

        calculation = calculation.replace("×", "*")
        calculation = calculation.replace("÷", "/")
        calculation = calculation.replace("π", str(math.pi))

        # Percentage
        calculation = calculation.replace("%", "/100")

        allowed = "0123456789+-*/(). "

        if not all(char in allowed for char in calculation):
            raise ValueError

        result = eval(
            calculation,
            {"__builtins__": None},
            {}
        )

        # Make integers look cleaner
        if isinstance(result, float) and result.is_integer():
            result = int(result)

        history.insert(
            0,
            f"{expression} = {result}"
        )

        expression = str(result)
        update_display()

    except:
        display.delete(0, tk.END)
        display.insert(0, "Error")

        expression = ""


def square():
    global expression

    try:
        number = float(expression)

        result = number ** 2

        if result.is_integer():
            result = int(result)

        history.insert(
            0,
            f"{number}² = {result}"
        )

        expression = str(result)
        update_display()

    except:
        show_error()


def square_root():
    global expression

    try:
        number = float(expression)

        if number < 0:
            raise ValueError

        result = math.sqrt(number)

        if result.is_integer():
            result = int(result)

        history.insert(
            0,
            f"√{number} = {result}"
        )

        expression = str(result)
        update_display()

    except:
        show_error()


def scientific(function_name):
    global expression

    try:
        number = float(expression)

        if function_name == "sin":
            result = math.sin(math.radians(number))

        elif function_name == "cos":
            result = math.cos(math.radians(number))

        elif function_name == "tan":
            result = math.tan(math.radians(number))

        elif function_name == "log":
            if number <= 0:
                raise ValueError

            result = math.log10(number)

        if abs(result) < 0.0000001:
            result = 0

        expression = str(result)

        history.insert(
            0,
            f"{function_name}({number}) = {result}"
        )

        update_display()

    except:
        show_error()


def show_error():
    global expression

    display.delete(0, tk.END)
    display.insert(0, "Error")

    expression = ""


def clear_history():
    history.delete(0, tk.END)


# =========================================================
# HOVER EFFECT
# =========================================================

def hover(button, normal, hover_color):
    button.bind(
        "<Enter>",
        lambda event: button.config(bg=hover_color)
    )

    button.bind(
        "<Leave>",
        lambda event: button.config(bg=normal)
    )


