# =========================================================
# BUTTON CREATOR
# =========================================================

def create_button(
    text,
    row,
    column,
    command,
    bg_color=NUMBER_BG,
    hover_color=NUMBER_HOVER,
    width=5
):

    button = tk.Button(
        button_frame,
        text=text,
        command=command,
        font=("Arial", 15, "bold"),
        width=width,
        height=2,
        bg=bg_color,
        fg=TEXT,
        activebackground=hover_color,
        activeforeground=TEXT,
        bd=0,
        relief="flat",
        cursor="hand2"
    )

    button.grid(
        row=row,
        column=column,
        padx=4,
        pady=4
    )

    hover(
        button,
        bg_color,
        hover_color
    )

    return button


