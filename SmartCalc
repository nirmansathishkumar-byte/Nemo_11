# =========================================================
# KEYBOARD SUPPORT
# =========================================================

def keyboard_input(event):

    global expression

    key = event.keysym

    if event.char in "0123456789+-*/().":

        add_value(event.char)

    elif event.char == "%":

        add_value("%")

    elif key == "Return":

        calculate()

    elif key == "BackSpace":

        backspace()

    elif key == "Escape":

        clear()


window.bind("<Key>", keyboard_input)


